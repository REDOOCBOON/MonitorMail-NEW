# MonitorMail backend configuration template - copy to backend/.env and fill in

# Flask / auth
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL database that holds teachers, students, history and templates
DATABASE_URL=postgresql://postgres:password123@localhost:5432/neondb

# Admin account: always kept as an approved admin. ADMIN_PASSWORD is only used to create it if missing (must be strong).
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Ujjwal

# Teacher self-registration: only this domain may apply (admin approval required)
ALLOWED_TEACHER_DOMAIN=srmist.edu.in

# Google sign-in for sending mail through the Gmail API (needed on hosts that block SMTP, e.g. Render Free).
# Redirect URI to register in Google Cloud: <FRONTEND_ORIGIN>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# System account that sends OTP / approval emails. With Google sign-in, this account connects Gmail once
# (Account page); otherwise set its 16-character app password for SMTP.
SYSTEM_EMAIL=your-gmail@gmail.com
SYSTEM_EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Set to true only for local testing without a mailbox: OTPs are printed in the backend console
OTP_CONSOLE_FALLBACK=false

# Port 5000 is used by macOS AirPlay Receiver, so the API runs on 5001
PORT=5001

# Security
# Set to true when MonitorMail is served over HTTPS
COOKIE_SECURE=false
# 127.0.0.1 = only this computer can open MonitorMail; use 0.0.0.0 to allow other computers on the network
HOST=127.0.0.1
# Set to true only when running behind a reverse proxy (nginx, Render, ...)
TRUST_PROXY=false
